[{"eid": 0, "tag": "DIV", "sz": 24, "fam": "JBM", "x": 80, "y": 64, "w": 1760, "a": 1, "text": "SE2RoadNet · 13"}, {"eid": 1, "tag": "H2", "sz": 46, "fam": "BV", "x": 80, "y": 101, "w": 1760, "a": 1, "text": "Bước 1: 7 kênh đặc trưng bất biến SE(2)"}, {"eid": 2, "tag": "DIV", "sz": 30, "fam": "BV", "x": 115, "y": 220, "w": 926, "a": 1, "text": "Chỉ giữ đại lượng nội tại của đường"}, {"eid": 3, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 272, "w": 926, "a": 1, "text": "1. Δsi — chiều dài đoạn i"}, {"eid": 4, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 325, "w": 926, "a": 1, "text": "2. |Δθi| — biến thiên góc tuyệt đối"}, {"eid": 5, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 378, "w": 926, "a": 1, "text": "3. κi = Δθi/Δsi — độ cong có dấu"}, {"eid": 6, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 430, "w": 926, "a": 1, "text": "4. dκ/ds — đạo hàm độ cong (jerk hình học)"}, {"eid": 7, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 478, "w": 926, "a": 1, "text": "5. d²κ/ds² — đạo hàm bậc 2"}, {"eid": 8, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 525, "w": 926, "a": 1, "text": "6. s_norm = s/L ∈ [0,1] — chiều dài cung tương đối"}, {"eid": 9, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 573, "w": 926, "a": 1, "text": "7. σ_local(κ) — độ lệch chuẩn cục bộ (cửa sổ 11)"}, {"eid": 10, "tag": "DIV", "sz": 27, "fam": "BV", "x": 115, "y": 882, "w": 926, "a": 1, "text": "⇒ 0 kênh phụ thuộc khung quy chiếu (đã bỏ sinθ, cosθ, θ)."}, {"eid": 11, "tag": "DIV", "sz": 24, "fam": "BV", "x": 1135, "y": 856, "w": 674, "a": 1, "text": "Các đại lượng nội tại tính trên từng cặp điểm liền kề — không thay đổi khi xoay/tịnh tiến."}, {"eid": 12, "tag": "DIV", "sz": 26, "fam": "BV", "x": 80, "y": 984, "w": 1760, "a": 1, "text": "Takeaway: Bất biến SE(2) được đảm bảo từ khâu đặc trưng — trước khi mô hình học."}]