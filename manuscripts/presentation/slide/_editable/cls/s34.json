[{"eid": 0, "tag": "DIV", "sz": 24, "fam": "JBM", "x": 80, "y": 64, "w": 1760, "a": 1, "text": "Backup · B3"}, {"eid": 1, "tag": "H2", "sz": 46, "fam": "BV", "x": 80, "y": 101, "w": 1760, "a": 1, "text": "Resolution probe (bất biến lấy mẫu)"}, {"eid": 2, "tag": "DIV", "sz": 28, "fam": "BV", "x": 112, "y": 402, "w": 927, "a": 1, "text": "Lấy cùng một con đường, resample ở N ∈ {64,...,197} điểm rồi đánh giá lại."}, {"eid": 3, "tag": "DIV", "sz": 28, "fam": "BV", "x": 112, "y": 506, "w": 537, "a": 1, "text": "Đo Δ = max − min APFD qua các mức N."}, {"eid": 4, "tag": "DIV", "sz": 28, "fam": "BV", "x": 112, "y": 568, "w": 927, "a": 1, "text": "Kết quả: Δ ~ 0.0012 — rất nhỏ nhưng chưa exact như phép xoay (Δ=0)."}, {"eid": 5, "tag": "DIV", "sz": 28, "fam": "BV", "x": 112, "y": 672, "w": 927, "a": 1, "text": "Lý do: bias RFF theo Δs là gần-bất-biến tại tham số hóa, không tuyệt đối ⇒ hướng RoPE-1D."}, {"eid": 6, "tag": "DIV", "sz": 22, "fam": "JBM", "x": 1104, "y": 224, "w": 703, "a": 1, "text": "APFD vs N (resample)"}, {"eid": 7, "tag": "SPAN", "sz": 20, "fam": "BV", "x": 1153, "y": 292, "w": 62, "a": 1, "text": ".8060"}, {"eid": 8, "tag": "SPAN", "sz": 20, "fam": "BV", "x": 1334, "y": 265, "w": 62, "a": 1, "text": ".8066"}, {"eid": 9, "tag": "SPAN", "sz": 20, "fam": "BV", "x": 1516, "y": 243, "w": 59, "a": 1, "text": ".8072"}, {"eid": 10, "tag": "SPAN", "sz": 20, "fam": "BV", "x": 1697, "y": 259, "w": 60, "a": 1, "text": ".8067"}, {"eid": 11, "tag": "DIV", "sz": 20, "fam": "JBM", "x": 1104, "y": 870, "w": 161, "a": 1, "text": "64"}, {"eid": 12, "tag": "DIV", "sz": 20, "fam": "JBM", "x": 1285, "y": 870, "w": 161, "a": 1, "text": "100"}, {"eid": 13, "tag": "DIV", "sz": 20, "fam": "JBM", "x": 1465, "y": 870, "w": 161, "a": 1, "text": "150"}, {"eid": 14, "tag": "DIV", "sz": 20, "fam": "JBM", "x": 1646, "y": 870, "w": 161, "a": 1, "text": "197"}, {"eid": 15, "tag": "DIV", "sz": 26, "fam": "BV", "x": 1104, "y": 914, "w": 703, "a": 1, "text": "Δ = 0.0012 (max − min)"}, {"eid": 16, "tag": "DIV", "sz": 26, "fam": "BV", "x": 80, "y": 984, "w": 1760, "a": 1, "text": "Takeaway: Phép xoay: Δ=0 exact (bằng kiến trúc). Lấy mẫu: Δ ~ 0.0012 (gần như, đang tiến tới exact)."}]