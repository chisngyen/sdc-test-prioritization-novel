[{"eid": 0, "tag": "DIV", "sz": 24, "fam": "JBM", "x": 80, "y": 64, "w": 1760, "a": 1, "text": "Đánh giá · 17"}, {"eid": 1, "tag": "H2", "sz": 46, "fam": "BV", "x": 80, "y": 101, "w": 1760, "a": 1, "text": "Chỉ số APFD & Giao thức đánh giá"}, {"eid": 2, "tag": "DIV", "sz": 27, "fam": "BV", "x": 111, "y": 212, "w": 948, "a": 1, "text": "Average Percentage of Faults Detected"}, {"eid": 3, "tag": "DIV", "sz": 24, "fam": "BV", "x": 111, "y": 260, "w": 948, "a": 1, "text": "Với hoán vị π trên n test (m là FAIL), TFi là vị trí fault thứ i:"}, {"eid": 4, "tag": "DIV", "sz": 30, "fam": "JBM", "x": 111, "y": 315, "w": 948, "a": 1, "text": "APFD(π) = 1 − (Σ TFi)/(n·m) + 1/(2n)"}, {"eid": 5, "tag": "DIV", "sz": 24, "fam": "BV", "x": 111, "y": 409, "w": 948, "a": 1, "text": "Khoảng [0,1], càng cao càng tốt. Ngẫu nhiên ~ 0.5; Lý tưởng ~ 1.0."}, {"eid": 6, "tag": "DIV", "sz": 22, "fam": "BV", "x": 1145, "y": 587, "w": 668, "a": 1, "text": "Ranking tốt ⇒ đường cong dốc đứng từ đầu."}, {"eid": 7, "tag": "DIV", "sz": 26, "fam": "BV", "x": 107, "y": 691, "w": 487, "a": 1, "text": "1. Single-pass"}, {"eid": 8, "tag": "DIV", "sz": 24, "fam": "BV", "x": 107, "y": 738, "w": 487, "a": 1, "text": "Xếp hạng 1 lần trên toàn Competition split (956 test)"}, {"eid": 9, "tag": "DIV", "sz": 30, "fam": "JBM", "x": 107, "y": 879, "w": 487, "a": 1, "text": "APFD = 0.8047"}, {"eid": 10, "tag": "DIV", "sz": 40, "fam": "BV", "x": 635, "y": 660, "w": 40, "a": 1, "text": "→"}, {"eid": 11, "tag": "DIV", "sz": 26, "fam": "BV", "x": 716, "y": 691, "w": 487, "a": 1, "text": "2. Multi-trial (30 lần)"}, {"eid": 12, "tag": "DIV", "sz": 24, "fam": "BV", "x": 716, "y": 736, "w": 487, "a": 1, "text": "Mỗi trial: lấy ngẫu nhiên 287/956 test → APFD"}, {"eid": 13, "tag": "DIV", "sz": 28, "fam": "JBM", "x": 716, "y": 839, "w": 487, "a": 1, "text": "0.8048 ± 0.0118"}, {"eid": 14, "tag": "DIV", "sz": 22, "fam": "BV", "x": 716, "y": 914, "w": 487, "a": 1, "text": "loại \"may rủi\" do thứ tự cố định"}, {"eid": 15, "tag": 