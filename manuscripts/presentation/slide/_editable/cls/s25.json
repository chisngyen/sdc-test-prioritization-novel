[{"eid": 0, "tag": "DIV", "sz": 24, "fam": "JBM", "x": 80, "y": 64, "w": 1760, "a": 1, "text": "Đánh giá · 20"}, {"eid": 1, "tag": "H2", "sz": 46, "fam": "BV", "x": 80, "y": 101, "w": 1760, "a": 1, "text": "AUC vs APFD: vì sao tách bạch?"}, {"eid": 2, "tag": "DIV", "sz": 27, "fam": "BV", "x": 81, "y": 192, "w": 864, "a": 1, "text": "AUC đo khả năng phân loại PASS/FAIL trên từng cặp — không quan tâm thứ hạng tuyệt đối."}, {"eid": 3, "tag": "DIV", "sz": 27, "fam": "BV", "x": 975, "y": 192, "w": 864, "a": 1, "text": "APFD đo tốc độ lộ lỗi theo thứ tự chạy — chính là cái Competition tối ưu."}, {"eid": 4, "tag": "SPAN", "sz": 26, "fam": "BV", "x": 80, "y": 552, "w": 26, "a": 1, "text": "→"}, {"eid": 5, "tag": "DIV", "sz": 26, "fam": "BV", "x": 122, "y": 552, "w": 944, "a": 1, "text": "Trong gần như mọi thí nghiệm của nhóm, AUC và APFD phân kỳ: tăng AUC không đảm bảo tăng APFD."}, {"eid": 6, "tag": "SPAN", "sz": 26, "fam": "BV", "x": 80, "y": 658, "w": 26, "a": 1, "text": "→"}, {"eid": 7, "tag": "DIV", "sz": 26, "fam": "BV", "x": 122, "y": 658, "w": 929, "a": 1, "text": "SE2RoadNet tăng AUC (0.917 → 0.934) trong khi APFD giữ đỉnh (~0.805)."}, {"eid": 8, "tag": "SPAN", "sz": 26, "fam": "BV", "x": 80, "y": 725, "w": 23, "a": 1, "text": "⇒"}, {"eid": 9, "tag": "DIV", "sz": 26, "fam": "BV", "x": 119, "y": 725, "w": 906, "a": 1, "text": "Khi báo cáo phải nói rõ metric nào đang được tối ưu cho tình huống nào."}, {"eid": 10, "tag": "DIV", "sz": 22, "fam": "JBM", "x": 1129, "y": 371, "w": 680, "a": 1, "text": "SE2RoadNet · cùng 1 mô hình"}, {"eid": 11, "tag": "DIV", "sz": 22, "fam": "BV", "x": 1129, "y": 917, "w": 680, "a": 1, "text": "AUC tăng, APFD gần như phẳng"}, {"eid": 12, "tag": "DIV", "sz": 26, "fam": "BV", "x": 80, "y": 984, "w": 1760, "a": 1, "text": "Takeaway: Không gộp AUC và APFD thành \"một điểm tốt hơn\" — chúng đo hai thứ khác nhau."}]