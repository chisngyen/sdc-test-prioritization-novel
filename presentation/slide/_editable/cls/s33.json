[{"eid": 0, "tag": "DIV", "sz": 24, "fam": "JBM", "x": 80, "y": 64, "w": 1760, "a": 1, "text": "Backup · B2"}, {"eid": 1, "tag": "H2", "sz": 46, "fam": "BV", "x": 80, "y": 101, "w": 1760, "a": 1, "text": "Multi-trial protocol (vì sao 30 lần?)"}, {"eid": 2, "tag": "DIV", "sz": 28, "fam": "BV", "x": 114, "y": 339, "w": 1097, "a": 1, "text": "APFD single-pass nhạy với thứ tự cố định của tập test ⇒ một con số dễ “may rủi”."}, {"eid": 3, "tag": "DIV", "sz": 28, "fam": "BV", "x": 114, "y": 404, "w": 1082, "a": 1, "text": "Mỗi trial: lấy ngẫu nhiên max(50, 0.3·|test|) = 287/956 test, tính APFD độc lập."}, {"eid": 4, "tag": "DIV", "sz": 28, "fam": "BV", "x": 114, "y": 470, "w": 590, "a": 1, "text": "Báo cáo APFD ± σ qua 30 trials, seed = 42."}, {"eid": 5, "tag": "DIV", "sz": 28, "fam": "BV", "x": 114, "y": 535, "w": 1018, "a": 1, "text": "σ thường là con số xuất bản quan trọng hơn mean (độ ổn định của ranking)."}, {"eid": 6, "tag": "DIV", "sz": 24, "fam": "JBM", "x": 717, "y": 643, "w": 486, "a": 1, "text": "SE2RoadNet"}, {"eid": 7, "tag": "DIV", "sz": 54, "fam": "JBM", "x": 717, "y": 684, "w": 486, "a": 1, "text": "0.8048 ± 0.0118"}, {"eid": 8, "tag": "DIV", "sz": 24, "fam": "BV", "x": 717, "y": 763, "w": 486, "a": 1, "text": "(mean ± σ, 30 trials)"}, {"eid": 9, "tag": "DIV", "sz": 26, "fam": "BV", "x": 80, "y": 984, "w": 1760, "a": 1, "text": "Takeaway: 30 trials biến một con số đơn lẻ thành phân phối có σ — độ tin cậy thay vì may rủi."}]